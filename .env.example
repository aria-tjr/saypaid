# ---------- PayPal ----------
# mock    = built-in PayPal Invoicing simulator (no account needed, clearly labelled MOCK in the UI)
# sandbox = real PayPal REST sandbox (https://api-m.sandbox.paypal.com)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id from your sandbox app (Dashboard > Apps > Webhooks) to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# ---------- AI ----------
# openai    = any OpenAI-compatible Chat Completions endpoint (OpenAI, a local llama.cpp server, Ollama, ...)
# anthropic = Anthropic Messages API (Claude)
# offline   = deterministic rule-based parser, no model at all (for quick judging without keys)
LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional label shown in the UI header, e.g. "Qwen3-4B · local llama.cpp"
LLM_LABEL=

# ---------- Business profile (shown on invoices) ----------
BUSINESS_NAME=Demo Repair Workshop
BUSINESS_CURRENCY=EUR
BUSINESS_TAX_RATE=19
BUSINESS_HOURLY_RATE=65
PAYMENT_TERM_DAYS=14

# ---------- Guardrails ----------
SOFT_LIMIT=1000
HARD_LIMIT=5000
REMINDER_COOLDOWN_DAYS=3

PORT=3000

# Optional (sandbox): email of your PayPal *sandbox personal* account. The demo customer
# "Cafe Morgenrot" will use it, so you can open the invoice link and pay it as the customer.
DEMO_PAYER_EMAIL=

# ---------- Automation (optional) ----------
# Outbound, HMAC-signed JSON events (invoice.sent, invoice.paid, ...) e.g. to an n8n Webhook node.
AUTOMATION_WEBHOOK_URL=
AUTOMATION_SECRET=
# Optional shared token required by POST /api/automation/overdue-sweep (header x-automation-token).
AUTOMATION_TOKEN=

# ---------- Mock tuning ----------
# Simulated PayPal latency in MOCK mode (ms).
MOCK_LATENCY_MS=140
