{
  "name": "SayPaid: weekday overdue sweep",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 8 * * 1-5" } ] }
      },
      "id": "b8f2b0a4-1d0e-4c55-9a51-0c6d2b1e0001",
      "name": "Weekdays 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SAYPAID_URL || 'http://localhost:3000' }}/api/automation/overdue-sweep",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "x-automation-token", "value": "={{ $env.SAYPAID_AUTOMATION_TOKEN }}" } ] },
        "options": {}
      },
      "id": "b8f2b0a4-1d0e-4c55-9a51-0c6d2b1e0002",
      "name": "Propose reminders for overdue invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    }
  ],
  "connections": {
    "Weekdays 08:00": { "main": [ [ { "node": "Propose reminders for overdue invoices", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "description": "Every weekday morning, asks SayPaid to queue PayPal reminders for every overdue invoice. Reminders are only PROPOSED: the owner still approves each one in the SayPaid UI." }
}
